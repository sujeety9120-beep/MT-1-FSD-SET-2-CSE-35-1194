const express = require('express');

const app = express();

app.use(express.json());

let students = [
    {
        id: 201,
        rollNumber: "CSE2401",
        name: "Rohit Sharma",
        branch: "CSE",
        semester: 3,
        email: "rohit@gmail.com"
    },
    {
        id: 202,
        rollNumber: "ECE2402",
        name: "Anjali Verma",
        branch: "ECE",
        semester: 3,
        email: "anjali@gmail.com"
    },
    {
        id: 203,
        rollNumber: "CSE2403",
        name: "Vikas Singh",
        branch: "CSE",
        semester: 3,
        email: "vikas@gmail.com"
    }
];

app.get('/api/students', (req, res) => {
    res.status(200).json(students);
});

app.post('/api/students', (req, res) => {
    const { rollNumber, name, branch, semester, email } = req.body;

    if (!rollNumber || !name || !branch || !semester || !email) {
        return res.status(400).json({
            message: "All fields are required"
        });
    }

    if (!Number.isInteger(semester) || semester <= 0) {
        return res.status(400).json({
            message: "Invalid semester"
        });
    }

    const exists = students.find(s => s.rollNumber === rollNumber);

    if (exists) {
        return res.status(400).json({
            message: "Roll number already exists"
        });
    }

    const newStudent = {
        id: Math.max(200, ...students.map(s => s.id)) + 1,
        rollNumber: rollNumber,
        name: name,
        branch: branch,
        semester: semester,
        email: email
    };

    students.push(newStudent);

    res.status(201).json(newStudent);
});

app.get('/api/students/:id', (req, res) => {
    const id = Number(req.params.id);

    const student = students.find(s => s.id === id);

    if (!student) {
        return res.status(404).json({
            message: "Student not found"
        });
    }

    res.status(200).json(student);
});

app.put('/api/students/:id', (req, res) => {
    const id = Number(req.params.id);

    const index = students.findIndex(s => s.id === id);

    if (index === -1) {
        return res.status(404).json({
            message: "Student not found"
        });
    }

    const { rollNumber, name, branch, semester, email } = req.body;

    if (!rollNumber || !name || !branch || !semester || !email) {
        return res.status(400).json({
            message: "All fields are required"
        });
    }

    if (!Number.isInteger(semester) || semester <= 0) {
        return res.status(400).json({
            message: "Invalid semester"
        });
    }

    const exists = students.find(
        (s, i) => i !== index && s.rollNumber === rollNumber
    );

    if (exists) {
        return res.status(400).json({
            message: "Roll number already exists"
        });
    }

    students[index] = {
        id: id,
        rollNumber: rollNumber,
        name: name,
        branch: branch,
        semester: semester,
        email: email
    };

    res.status(200).json(students[index]);
});

app.delete('/api/students/:id', (req, res) => {
    const id = Number(req.params.id);

    const index = students.findIndex(s => s.id === id);

    if (index === -1) {
        return res.status(404).json({
            message: "Student not found"
        });
    }

    students.splice(index, 1);

    res.status(200).json({
        message: "Student deleted successfully"
    });
});

app.get('/api/students/filter', (req, res) => {
    const branch = req.query.branch;

    if (!branch) {
        return res.status(400).json({
            message: "Please enter branch"
        });
    }

    const result = students.filter(
        s => s.branch.toLowerCase() === branch.toLowerCase()
    );

    res.status(200).json(result);
});

const PORT = 3000;

app.listen(PORT, () => {
    console.log("Server is running on port " + PORT);
});